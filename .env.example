# Moni - Agentic iMessage Trading for Base Tokenized Stocks
# Copy this file to .env and fill in your credentials

# ===========================================
# Spectrum (Photon) - iMessage Infrastructure
# ===========================================
# Get from: https://app.photon.codes/
# Required for production iMessage deployment
PROJECT_ID=
PROJECT_SECRET=

# ===========================================
# Privy - Embedded Wallets
# ===========================================
# Get from: https://dashboard.privy.io/
# Required for wallet authentication
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ===========================================
# Base Network
# ===========================================
# Mainnet: https://mainnet.base.org
# Sepolia: https://sepolia.base.org
# Or use a provider like Alchemy, Infura, QuickNode
BASE_RPC_URL=https://mainnet.base.org

# ===========================================
# 1inch - DEX Aggregation (Optional)
# ===========================================
# Get from: https://portal.1inch.dev/
# Used for swap quotes and execution
ONEINCH_API_KEY=

# ===========================================
# Letta - Agent Memory & Learning (Optional)
# ===========================================
# Get from: https://www.letta.com/
# Used for agentic features, memory, learning
LETTA_API_KEY=
LETTA_BASE_URL=https://api.letta.com

# ===========================================
# Application Settings
# ===========================================
# Set to 'true' for Builder Quest submission (simulated trades)
# Set to 'false' for production with real trades
DEMO_MODE=true

# Port for HTTP server (AtlasFlow health checks)
# Default: 3000
PORT=3000

# Node Environment
NODE_ENV=production
