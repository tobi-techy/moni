# Moni - Agentic iMessage Trading for Base Tokenized Stocks
# Copy this file to .env and fill in your credentials

# ===========================================
# Spectrum (Photon) - iMessage Infrastructure
# ===========================================
# Get from: https://app.photon.codes/
# Required for production iMessage deployment
PROJECT_ID=
PROJECT_SECRET=

# Webhook secret for receiving messages via HTTP (optional)
# Generate a random string: openssl rand -hex 32
SPECTRUM_WEBHOOK_SECRET=

# Webhook server port (default: 3001)
WEBHOOK_PORT=3001

# ===========================================
# Para - MPC Embedded Wallets
# ===========================================
# Get from: https://www.getpara.com/
# Required for wallet provisioning + REST signing
PARA_API_KEY=
# PROD, BETA, or SANDBOX (default: BETA). Aliases like PRODUCTION are
# normalized automatically; a full https:// URL is treated as a custom base URL.
PARA_ENVIRONMENT=BETA
# Optional: explicit REST base URL override (takes precedence over PARA_ENVIRONMENT)
# PARA_REST_BASE_URL=https://api.beta.getpara.com

# ===========================================
# Base Network
# ===========================================
# Mainnet: https://mainnet.base.org
# Sepolia: https://sepolia.base.org
# Or use a provider like Alchemy, Infura, QuickNode
BASE_RPC_URL=https://mainnet.base.org

# ===========================================
# 1inch - DEX Aggregation (Optional)
# ===========================================
# Get from: https://business.1inch.com/portal
# Used for swap quotes and execution (Swap API v6.1, api.1inch.com)
ONEINCH_API_KEY=

# ===========================================
# Cencori - AI Provider (Optional)
# ===========================================
# Get from: https://cencori.com
# Used for the agentic AI brain and conversation
CENCORI_API_KEY=
# Optional: model to use (defaults to claude-sonnet-4.5)
# Options: gpt-4o, claude-sonnet-4.5, gemini-2.5-flash
CENCORI_MODEL=claude-sonnet-4.5

# ===========================================
# Application Settings
# ===========================================
# Set to 'true' for Builder Quest submission (simulated trades)
# Set to 'false' for production with real trades
DEMO_MODE=true

# Port for HTTP server (AtlasFlow health checks)
# Default: 3000
PORT=3000

# Node Environment
NODE_ENV=production