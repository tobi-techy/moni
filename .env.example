# Moni - Agentic iMessage Trading for Base Tokenized Stocks
# Copy this file to .env and fill in your credentials

# ===========================================
# Spectrum (Photon) - iMessage Infrastructure
# ===========================================
# Get from: https://app.photon.codes/
# Required for production iMessage deployment
PROJECT_ID=
PROJECT_SECRET=

# Webhook secret for receiving messages via HTTP (optional)
# Generate a random string: openssl rand -hex 32
SPECTRUM_WEBHOOK_SECRET=

# Webhook server port (default: 3001)
WEBHOOK_PORT=3001

# ===========================================
# Para - MPC Embedded Wallets
# ===========================================
# Get from: https://www.getpara.com/
# Required for wallet provisioning + REST signing
PARA_API_KEY=
# PROD for live wallets (api.getpara.com). BETA/SANDBOX are Para test
# environments. Moni is mainnet-only, so use PROD for live trading.
PARA_ENVIRONMENT=PROD
# Optional: explicit REST base URL override (takes precedence over PARA_ENVIRONMENT)
# PARA_REST_BASE_URL=https://api.getpara.com

# ===========================================
# Base Network (MAINNET ONLY)
# ===========================================
# Coinbase B20 tokenized stocks ONLY exist on Base mainnet — there are no B20
# contracts on Base Sepolia, so a testnet RPC will be rejected at startup
# (validateEnv fails with a clear error).
BASE_RPC_URL=https://mainnet.base.org
# Optional: comma-separated JSON-RPC failover endpoints (auto-spread/fallback
# when mainnet.base.org rate-limits with -32016). A paid Alchemy/Infura/QuickNode
# URL here is recommended for production.
# BASE_RPC_FALLBACKS=https://base-rpc.publicnode.com,https://1rpc.io/base,https://base.drpc.org

# ===========================================
# 1inch - DEX Aggregation (Optional)
# ===========================================
# Get from: https://business.1inch.com/portal
# Used for swap quotes and execution (Swap API v6.1, api.1inch.com)
ONEINCH_API_KEY=

# ===========================================
# Cencori - AI Provider (Optional)
# ===========================================
# Get from: https://cencori.com
# Used for the agentic AI brain and conversation
CENCORI_API_KEY=
# Optional: model to use (defaults to gpt-4o — the model must be one the
# Cencori plan/key supports, e.g. gpt-4o; claude-sonnet-4.5 is NOT valid on all plans)
CENCORI_MODEL=gpt-4o

# ===========================================
# Application Settings
# ===========================================
# Port for HTTP server (AtlasFlow health checks)
# Default: 3000
PORT=3000

# Node Environment
NODE_ENV=production